FROM public.ecr.aws/lambda/python:3.11

# Copiar requirements
COPY requirements.txt ${LAMBDA_TASK_ROOT}

# Instalar herramientas de compilación, actualizar pip y luego instalar dependencias
# Se usa --no-cache-dir y yum clean all para mantener el tamaño de la imagen pequeño
RUN yum update -y && \
    yum install -y gcc gcc-c++ make && \
    pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    yum clean all

# Copiar el código fuente de la aplicación (solo la carpeta app)
COPY app/ ${LAMBDA_TASK_ROOT}/app/

# Opcional: copiar scripts si necesitas correr seeders en Lambda
# COPY scripts/ ${LAMBDA_TASK_ROOT}/scripts/

# El CMD establece el punto de entrada (handler) de Lambda apuntando a Mangum
CMD ["app.main.handler"]
